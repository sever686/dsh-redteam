{
  "name": "@dsh-external/dsh-redteam",
  "description": "Red-team operations console: a sidebar-foot trigger plus a full-screen shell.overlay console (dashboard, targets, jobs, sessions, credentials, reports) with a plugin-extensible redteam.section slot",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sever686/dsh-redteam.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "redteam": "lib/bin/redteam.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./redteam.patch.yml": "./redteam.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./redteam.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-store": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-invariants": "^0.1.3-alpha.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/bin/redteam.js",
    "redteam.patch.yml",
    "lib/types/**/*.d.ts"
  ]
}
